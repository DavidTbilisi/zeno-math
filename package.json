{
  "name": "zeno-math",
  "private": true,
  "version": "0.1.0",
  "description": "Zeno: a free, self-hostable math whiteboard, from zero to advanced, one small step at a time",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && concurrently -n web,api -c blue,green \"vite\" \"node --watch server/index.ts\"",
    "build": "node scripts/copy-assets.mjs && vite build && node scripts/compress.mjs",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "model": "node --disable-warning=ExperimentalWarning scripts/evaluate-model.ts",
    "import-assistments": "node --disable-warning=ExperimentalWarning scripts/import-assistments.ts",
    "simulate": "node --disable-warning=ExperimentalWarning scripts/simulate-study.ts",
    "analyse": "node --disable-warning=ExperimentalWarning scripts/analyse-study.ts",
    "dry-run": "node --disable-warning=ExperimentalWarning --import ./scripts/ts-register.mjs scripts/dry-run-study.ts",
    "checker-agreement": "node --disable-warning=ExperimentalWarning --import ./scripts/ts-register.mjs scripts/checker-agreement.ts",
    "test": "node --import ./scripts/ts-register.mjs --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "mathjax-full": "^3.2.2",
    "mathjs": "^15.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
